# Meshline WiFi Laravel port — copy to laravel/.env and adjust for your machine.
# Values below are the local development defaults mirrored from the legacy
# Node setup; replace ALL secrets before exposing the app to the internet.

# ---------------------------------------------------------------- App / HTTP
APP_NAME="Meshline WiFi"
APP_ENV=local
APP_KEY=base64:biU+PmtVR9bBzJ0cJkEVQc0BsIy6HR7jpG8bYMdA+0g=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Africa/Dar_es_Salaam
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug
TRUST_PROXY=true
ALLOWED_ORIGINS=http://localhost:8000

# --------------------------------------------------------------- Database
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=meshline_wifi
DB_NAME=hotbando         # legacy / FreeRADIUS alias
DB_USERNAME=root
DB_PASSWORD=
DB_ROOT_PASSWORD=aNiFGF6w3pwxJ0JD
DB_POOL_SIZE=50
DB_SSL=false

# ---------------------------------------------------------------- Sessions
# Legacy express-mysql-session used a MySQL table; Laravel uses `laravel_sessions`
# with the same cookie name. This is a deliberate session-store break: see
# laravel/docs/PORTING_STATUS.md for the cutover plan.
SESSION_DRIVER=database
SESSION_TABLE=laravel_sessions
SESSION_COOKIE=meshline_sid
SESSION_LIFETIME=1440
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SAME_SITE=lax
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
COOKIE_SECURE=false      # set true behind HTTPS
SESSION_SECRET=55180bfdb19511d353ce72efebad75e42bbbc68d13e24b60081e26228587bef8
SESSION_MAX_AGE=86400000
SESSION_SECURE=false     # legacy alias
SESSION_CONNECTION=
SESSION_STORE=

# -------------------------------------------------------------------- CSRF
# There is no CSRF_* driver: Laravel's session-bound token is used. The Vue
# client fetches GET /api/csrf and sends X-CSRF-TOKEN on mutating requests.
# Token helper: csrf_token(). Login/register/logout/webhooks/zero-touch are
# exempt via laravel/bootstrap/app.php.
CSRF_SECRET=CHANGE_ME_CSRF_SECRET_LEGACY_ONLY
CSRF_WEBHOOK_MAX_BODY_BYTES=1mb

# ------------------------------------------------------------- Cache/queue
CACHE_STORE=redis        # use "database"/"array" if Redis is unavailable
QUEUE_CONNECTION=database
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
REDIS_PASSWORD=C7a44GFsK-4Ar2PM
REDIS_DB=0

# -------------------------------------------------------------- Encryption
# PBKDF2/AES-256-GCM key shared with utils/encryption.js (64 hex chars or >=32 chars).
# Changing this makes stored router secrets unreadable.
ENCRYPTION_KEY=55180bfdb19511d353ce72efebad75e42bbbc68d13e24b60081e26228587bef8

# ---------------------------------------------------------------- ClickPesa
CLICKPESA_CLIENT_ID=IDvN542DsTmk0rNqMMbY59fkEab8zay8
CLICKPESA_API_KEY=SKrVEofljnVCwfZ4SfQpJdo4fhLdZmBknveB61BH38
CLICKPESA_CHECKSUM_KEY=
CLICKPESA_BASE_URL=https://api.clickpesa.com/third-parties
CLICKPESA_ENV=live
CLICKPESA_TEST_MODE=false
CLICKPESA_WEBHOOK_SECRET=
CLICKPESA_WEBHOOK_RATE_LIMIT_MAX=60
CLICKPESA_WEBHOOK_RATE_LIMIT_WINDOW_MS=60000
CLICKPESA_WEBHOOK_MAX_BODY_BYTES=1mb
DEMO_PAYMENTS=false      # NEVER true in production

# ------------------------------------------------------------------ RADIUS
RADIUS_ENABLED=false
RADIUS_HOST=127.0.0.1
RADIUS_PORT=1812
RADIUS_SECRET=d75158fa554f26306ea6b4c5b732e0a4743f2cda96d56d7782d1352e95c76cd6
HOTSPOT_IP=10.5.50.1
HOTSPOT_SUBNET=10.5.50.0

# --------------------------------------------------------- Router / Omada
# Per-router overrides live in mikrotiks.driver; ROUTER_DRIVER is the fallback.
ROUTER_DRIVER=mikrotik
MIKROTIK_DEFAULT_HOST=192.168.88.1
MIKROTIK_DEFAULT_USER=admin
MIKROTIK_DEFAULT_PASSWORD=CHANGE_ME
MIKROTIK_API_PASSWORD=CHANGE_ME
MIKROTIK_DEFAULT_PORT=8728
MIKROTIK_TIMEOUT=5

# onprem  -> https://<controller-host>:8043/api/v2 + cookie/X-CSRFToken
# cloud   -> https://omada.tplinknetwork.com/api/v2 + client credentials
OMADA_MODE=onprem
OMADA_CONTROLLER_URL=https://192.168.88.10:8043
OMADA_SITE_ID=
OMADA_USERNAME=admin
OMADA_PASSWORD=
OMADA_VERIFY_TLS=false
OMADA_TIMEOUT=10
OMADA_CLOUD_URL=https://omada.tplinknetwork.com
OMADA_CLIENT_ID=
OMADA_CLIENT_SECRET=

# ---------------------------------------------------------------- Collector
COLLECTOR_KEY=
COLLECTOR_NAME=site-collector
CLOUD_WS_URL=wss://localhost/api/collector/ws
COLLECTOR_HTTP_PORT=8081

# ------------------------------------------------------------- Zero-touch
ROUTER_REGISTRATION_SECRET=CHANGE_ME_32_HEX
SERVER_PUBLIC_HOST=localhost
WG_PORT=51820
WG_NETWORK=10.7.0.0/16
WG_SERVER_IP=10.7.0.1
WG_INTERFACE=wg0
WG_PUBLIC_IFACE=eth0
WG_SERVER_PUBLIC_KEY=CHANGE_ME_SERVER_WG_PUBLIC_KEY

# --------------------------------------------------------------- Scheduler
# Opt-in: enables the 30-second gauge refresh (hotbando:jobs:metrics).
METRICS_REFRESH_ENABLED=false

# ------------------------------------------------------------------- Misc
BCRYPT_ROUNDS=12
VOUCHER_LENGTH=10
VOUCHER_PREFIX=HB
DEFAULT_VOUCHER_EXPIRY_DAYS=30
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./public/uploads
BACKUP_RETENTION_DAYS=7
